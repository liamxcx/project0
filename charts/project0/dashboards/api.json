{
  "uid": "project0-api",
  "title": "project0 / API",
  "tags": ["project0"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Última ejecución correcta del collector",
      "description": "Tiempo desde la última vez que el CronJob del collector acabó bien. Corre cada hora, así que más de dos horas quiere decir que ha fallado al menos una vez.",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - kube_cronjob_status_last_successful_time{namespace=\"project0\", cronjob=\"collector\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 7200 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errores (5xx)",
      "description": "Porcentaje de respuestas 5xx sobre el total. Los 404 no cuentan, porque una partida que no existe es una respuesta correcta.",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_requests_total{namespace=\"project0\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total{namespace=\"project0\", route!~\"/health|/ready|/metrics\"}[$__rate_interval]))",
          "legendFormat": "errores"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Peticiones por segundo",
      "description": "Por ruta, sumando los pods. Sin las sondas de Kubernetes ni las lecturas de Prometheus.",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{namespace=\"project0\", route!~\"/health|/ready|/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tiempo de respuesta (p95)",
      "description": "El tiempo que no supera el 95% de las peticiones, por ruta. Sale del histograma, así que es una estimación dentro del tramo.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket{namespace=\"project0\", route!~\"/health|/ready|/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Actualizaciones desde la web",
      "description": "Pulsaciones del botón de actualizar en el rango elegido, según lo que respondió la API. Salen de la misma métrica que el resto del dashboard.",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(http_requests_total{namespace=\"project0\", route=\"/refresh\", method=\"POST\"}[$__range]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "202" }, "properties": [{ "id": "displayName", "value": "Lanzadas" }] },
          { "matcher": { "id": "byName", "options": "429" }, "properties": [{ "id": "displayName", "value": "Rechazadas por la espera" }] },
          { "matcher": { "id": "byName", "options": "409" }, "properties": [{ "id": "displayName", "value": "Ya había una en marcha" }] },
          { "matcher": { "id": "byName", "options": "502" }, "properties": [{ "id": "displayName", "value": "Fallo de Kubernetes" }] },
          { "matcher": { "id": "byName", "options": "503" }, "properties": [{ "id": "displayName", "value": "Fallo de Redis" }] }
        ]
      }
    }
  ]
}
